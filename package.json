{
  "name": "crt.watch",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "cross-env PORT=8080 npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build && npm --workspace apps/api run build",
    "start": "npm --workspace apps/api run start",
    "test": "vitest run",
    "typecheck": "npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.7",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.27.7": true,
    "ssh2@1.17.0": true
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
