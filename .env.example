NODE_ENV=production
TZ=Europe/Berlin
PORT=8080
HOST_PORT=8080
BASE_URL=http://localhost:8080
DATA_DIR=./data
DATABASE_PATH=/data/crtwatch.sqlite
SESSION_SECRET=change-this-long-random-secret
# Behind a reverse proxy: its addresses or networks, for example loopback,uniquelocal. Off for direct access.
TRUST_PROXY=false
COOKIE_SECURE=false
FRONT_PAGE_ENABLED=true
PUBLIC_REGISTRATION_ENABLED=true
ALLOW_PRIVATE_TARGETS=false
ALLOW_PRIVATE_NOTIFICATION_TARGETS=false
NOTIFICATION_ALLOWED_NETWORKS=
NOTIFICATION_MAX_REDIRECTS=3
NOTIFICATION_TIMEOUT_SECONDS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=1200
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
CONTENT_SECURITY_POLICY=enforce
CONTENT_SECURITY_POLICY_IMAGE_SOURCES=self data: https:
# /metrics: authenticated (METRICS_TOKEN, session or API token) or public.
METRICS_ACCESS=authenticated
# Bearer token for Prometheus, at least 32 characters, e.g. from: openssl rand -hex 32
METRICS_TOKEN=
PASSWORD_MIN_LENGTH=12
CHECK_CONCURRENCY=4
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_KEEP=14
DEFAULT_INTERVAL_SECONDS=3600
DEFAULT_WARNING_DAYS=30
DEFAULT_CRITICAL_DAYS=7
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
