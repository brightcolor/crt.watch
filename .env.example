NODE_ENV=production
TZ=Europe/Berlin
PORT=8080
HOST_PORT=8080
BASE_URL=http://localhost:8080
DATA_DIR=./data
DATABASE_PATH=/data/crtwatch.sqlite
SESSION_SECRET=change-this-long-random-secret
# Behind a reverse proxy: its addresses or networks, for example loopback,uniquelocal. Off for direct access.
TRUST_PROXY=false
COOKIE_SECURE=false
FRONT_PAGE_ENABLED=true
PUBLIC_REGISTRATION_ENABLED=true
ALLOW_PRIVATE_TARGETS=false
# Internal addresses or networks that monitors may check, for example 192.168.10.5, 10.20.0.0/16.
MONITOR_ALLOWED_NETWORKS=
MONITOR_MAX_REDIRECTS=20
MONITOR_HTTP_BODY_LIMIT_KB=1024
# Read per STARTTLS negotiation, banner or login; all connections of one check end after the deadline.
MONITOR_PROTOCOL_READ_LIMIT_KB=64
MONITOR_CHECK_DEADLINE_SECONDS=60
MONITOR_TLS_PROBE_TIMEOUT_SECONDS=3
# DNS details: nameservers resolved per zone, and their addresses queried after the monitor target check.
MONITOR_DNS_NAMESERVER_LIMIT=4
MONITOR_DNS_NAMESERVER_ADDRESS_LIMIT=6
ALLOW_PRIVATE_NOTIFICATION_TARGETS=false
NOTIFICATION_ALLOWED_NETWORKS=
NOTIFICATION_MAX_REDIRECTS=3
NOTIFICATION_TIMEOUT_SECONDS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=1200
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
CONTENT_SECURITY_POLICY=enforce
CONTENT_SECURITY_POLICY_IMAGE_SOURCES=self data: https:
# /metrics: authenticated (METRICS_TOKEN, session or API token) or public.
METRICS_ACCESS=authenticated
# Bearer token for Prometheus, at least 32 characters, e.g. from: openssl rand -hex 32
METRICS_TOKEN=
PASSWORD_MIN_LENGTH=12
SCHEDULER_INTERVAL_SECONDS=30
CHECK_CONCURRENCY=4
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_KEEP=14
DEFAULT_INTERVAL_SECONDS=3600
DEFAULT_WARNING_DAYS=30
DEFAULT_CRITICAL_DAYS=7
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
